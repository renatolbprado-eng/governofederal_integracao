# Configuração da Plataforma Local do Discord Bot
# Copie este arquivo para .env e preencha com as suas chaves.

# Token do Bot do Discord (obtido em https://discord.com/developers/applications)
DISCORD_TOKEN=seu_discord_bot_token_aqui

# ID do Servidor Principal (Guild ID)
GUILD_ID=seu_guild_id_aqui

# Porta para a interface web da Plataforma Local
PORT=4000
